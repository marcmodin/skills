<mxfile host="drawio">
  <diagram id="starter" name="Starter">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="520" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title and subtitle -->
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Diagram title&lt;/font&gt;&lt;/b&gt;&lt;br&gt;One sentence with the point the diagram makes" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="640" height="44" as="geometry" />
        </mxCell>

        <!-- Outside system -->
        <mxCell id="external" value="&lt;b&gt;Outside system&lt;/b&gt;&lt;br&gt;[what it is]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Boundary: plain, or swap for another container style -->
        <mxCell id="core" value="Boundary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6600CC;verticalAlign=bottom;align=right;spacingRight=10;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="170" width="380" height="240" as="geometry" />
        </mxCell>
        <mxCell id="component" value="&lt;b&gt;component&lt;/b&gt;&lt;br&gt;[what it holds]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note" value="A note about the container, in grey." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="240" height="30" as="geometry" />
        </mxCell>

        <!-- Grouping zone -->
        <mxCell id="zone" value="Zone name" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="170" width="400" height="240" as="geometry" />
        </mxCell>
        <mxCell id="resource" value="&lt;b&gt;Resource&lt;/b&gt;&lt;br&gt;[detail]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="520" y="230" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e-external" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;startFill=1;endArrow=classic;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="external" target="component">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-resource" value="label" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="component" target="resource">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="lg1" style="endArrow=classic;endFill=1;html=1;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="30" y="450" as="sourcePoint" />
            <mxPoint x="80" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lg1t" value="traffic, one way" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="440" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg2" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="30" y="480" as="sourcePoint" />
            <mxPoint x="80" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="lg2t" value="association, not traffic" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="470" width="200" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
